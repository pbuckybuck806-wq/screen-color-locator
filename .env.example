# Supabase project settings — Project Settings → API in the Supabase dashboard.
# Only the URL and the publishable (anon) key. The app never holds a secret/
# service-role key — see supabase/migrations/0001_init.sql for how access
# control is enforced (RLS + SECURITY DEFINER RPC functions) instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: external URL for the existing Package Help Desk app's hub tile.
# Leave unset to show a "not connected" toast instead.
NEXT_PUBLIC_PACKAGE_HELP_DESK_URL=

# Optional: shows a yellow banner across the top of every page reading
# "<value> environment — not production data". Set this to SANDBOX on the
# sandbox deployment (and leave it unset on production) so the team can't
# mistake one for the other.
NEXT_PUBLIC_ENV_LABEL=
